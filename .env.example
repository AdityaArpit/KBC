# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
APP_BASE_URL="MY_APP_URL"

# ADMIN AUTHENTICATION (Server-side secrets - Never exposed to client)
# Configured on server runtime
ADMIN_EMAIL="admin@kiit.ac.in"
ADMIN_PASSWORD="AdminSecret2026!"

# NOTION API INTEGRATION (Server-side secrets and database IDs)
NOTION_API_KEY=""
NOTION_EVENTS_DATABASE_ID=""
NOTION_SESSIONS_DATABASE_ID=""
NOTION_TASKS_DATABASE_ID=""
NOTION_PEOPLE_DATABASE_ID=""
NOTION_RESOURCES_DATABASE_ID=""
NOTION_VENUES_DATABASE_ID=""
NOTION_DECISIONS_DATABASE_ID=""
NOTION_DOCUMENTATION_DATABASE_ID=""
